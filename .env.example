# Copy to .env.local and fill in. .env.local is gitignored; this file is not.

# --- Database (Neon Postgres) ---------------------------------------------
# Neon dashboard → your project → Connection string (pooled). Include ?sslmode=require.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth.js --------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# scrypt hashes, one per account (generated with node:crypto — see auth setup).
AUTH_CHRIS_HASH=""
AUTH_JIAMIN_HASH=""

# --- Vercel Blob (image uploads) ------------------------------------------
BLOB_READ_WRITE_TOKEN=""


# --- Upstash (login rate limiting) ----------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
